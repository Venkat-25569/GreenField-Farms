# Supabase Configuration
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public API Key: VITE_SUPABASE_PUBLISHABLE_KEY (recommended) or VITE_SUPABASE_ANON_KEY
# Greenfield Farms supports both variable names.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NEVER put your service_role key here or in any VITE_ variable!
# The service_role key should only be used in secure server-side environments.
